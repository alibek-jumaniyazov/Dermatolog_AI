# FUTURE NATIVE UBUNTU SERVER TEMPLATE. dermatologai.uz is a planned name only.
# No DNS/domain ownership/server/live-deployment claim. Never commit real values.
# Copy to /etc/dermatologai/source.env owner root mode0600; split-env generates app/ml env.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=https://dermatologai.uz
TRUST_PROXY=127.0.0.1/32,::1/128
DATABASE_URL=postgresql://dermatologai:GENERATE_PASSWORD@127.0.0.1:5432/dermatologai
JWT_SECRET=GENERATE_UNIQUE_64_HEX_CHARACTERS
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_TOKEN=GENERATE_DIFFERENT_64_HEX_CHARACTERS
REDIS_URL=redis://:GENERATE_REDIS_PASSWORD@127.0.0.1:6379/0
# Explicit private disk option, outside repository and web root.
STORAGE_DRIVER=local
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=true
STORAGE_PATH=/var/lib/dermatologai/storage
TEMP_RETENTION_MINUTES=60
# Optional S3: switch driver and set these; bucket must remain private.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Explicit provider/model; general visual review, not a validated clinical classifier.
AI_PROVIDER=openai
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=SET_PROVIDER_KEY_ON_SERVER_ONLY
ML_MODEL_MANIFEST=/opt/dermatologai/current/ml/artifacts/manifest.json
ML_TRUSTED_ARTIFACT_SHA256=
# Real SMTP later. Port587=STARTTLS; port465 requires SMTP_SECURE=true.
SMTP_HOST=replace-with-smtp-host.invalid
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=SET_SMTP_USERNAME
SMTP_PASSWORD=SET_SMTP_PASSWORD
SMTP_FROM=Raqamli Dermatolog <noreply@dermatologai.uz>
# Public build values. Default noindex while domain/server not configured.
VITE_SITE_URL=https://dermatologai.uz
VITE_ALLOW_INDEXING=false
# Backup encryption key goes in separate root-only /etc/dermatologai/backup.env:
# BACKUP_KEY_HEX=<32 random bytes as 64 hex characters, escrowed off-host>
