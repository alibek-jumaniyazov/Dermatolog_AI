{
  "name": "@derma/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && vite build --ssr src/seo/prerender.tsx --outDir .seo-build && node scripts/seo-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:seo": "node scripts/seo-check.mjs",
    "test:seo:browser": "node scripts/seo-check.mjs --browser"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@ant-design/v5-patch-for-react-19": "1.0.3",
    "@tanstack/react-query": "5.103.2",
    "antd": "5.29.3",
    "axios": "1.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "typescript-eslint": "8.70.1",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
